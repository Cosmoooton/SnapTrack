NODE_ENV=development
PORT=3000
# Mindestens 32 zufällige Zeichen verwenden.
SESSION_SECRET=
# Nur setzen, wenn die Anwendung hinter einem vertrauenswürdigen Reverse-Proxy läuft.
TRUST_PROXY=0
# Aufbewahrungsfrist für gelöschte Daten; keine automatische Bereinigung.
DELETED_RETENTION_DAYS=30
# Vertrauenswürdige externe HTTPS-Adresse für Passwort-Reset-Links.
PUBLIC_BASE_URL=
