<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container dashboard py-4 py-md-5">
  <% if (!currentUser.force_password_change) { %><a href="/account" class="back-link"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Zurück zu den Accounteinstellungen</a><% } %>
  <div class="card border-0 shadow-sm surface-card form-card mt-4"><div class="card-body p-4 p-sm-5">
    <h1 class="h3 fw-semibold">Passwort ändern</h1>
    <p class="text-secondary mb-4">Wähle ein neues Passwort für dein Konto.</p>
    <% if (currentUser.force_password_change) { %><div class="alert alert-warning" role="status">Bitte ändere dein Passwort, bevor du fortfährst.</div><% } %>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" role="status">Dein Passwort wurde geändert.</div><% } %>
    <form method="post" action="/account/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (!currentUser.force_password_change) { %><div class="mb-3"><label class="form-label fw-medium" for="currentPassword">Bisheriges Passwort</label><input class="form-control" type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required></div><% } %>
      <div class="mb-3"><label class="form-label fw-medium" for="newPassword">Neues Passwort</label><input class="form-control" type="password" id="newPassword" name="newPassword" autocomplete="new-password" aria-describedby="password-rules" required></div>
      <div class="mb-3"><label class="form-label fw-medium" for="confirmPassword">Neues Passwort bestätigen</label><input class="form-control" type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required></div>
      <div class="form-actions mt-4"><button class="btn btn-primary" type="submit">Passwort speichern</button><% if (!currentUser.force_password_change) { %><a class="btn btn-secondary" href="/account">Abbrechen</a><% } %></div>
    </form>
    <section id="password-rules" class="password-rules mt-4" aria-label="Passwortanforderungen">
      <p class="small fw-semibold mb-2">Dein neues Passwort benötigt:</p>
      <ul class="list-unstyled small mb-0">
        <li data-rule="length"><i class="bi bi-circle" aria-hidden="true"></i> Mindestens 8 Zeichen</li>
        <li data-rule="number"><i class="bi bi-circle" aria-hidden="true"></i> Eine Zahl</li>
        <li data-rule="special"><i class="bi bi-circle" aria-hidden="true"></i> Ein Sonderzeichen</li>
        <li data-rule="upper"><i class="bi bi-circle" aria-hidden="true"></i> Einen Großbuchstaben (A–Z)</li>
        <li data-rule="lower"><i class="bi bi-circle" aria-hidden="true"></i> Einen Kleinbuchstaben (a–z)</li>
      </ul>
    </section>
  </div></div>
</main>
<script src="<%= assetBase %>/js/password.js" defer></script>
<%- include('../partials/footer') %>
