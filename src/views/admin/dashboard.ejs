<%- include('partials/start') %>
<h1 class="h2 mb-4">Admin-Übersicht</h1>
<div class="admin-metrics"><% [['Nutzer',summary.users],['Aktive Nutzer',summary.active],['Gesperrt / deaktiviert',summary.suspended],['Snapchat-Accounts',summary.profiles],['Score-Einträge',summary.scores],['Neue Nutzer · 7 Tage',summary.registrations],['Scores · 24 Stunden',summary.recent_scores],['Aktive Sitzungen',summary.sessions],['Fehler · 24 Stunden','Nicht verfügbar']].forEach(([label,value]) => { %><div class="card border-0"><div class="card-body"><div class="small text-secondary"><%= label %></div><strong class="fs-4"><%= value %></strong></div></div><% }) %></div>
<div class="row g-4 mt-2"><section class="col-lg-6"><div class="card border-0 h-100"><div class="card-body"><h2 class="h5">Letzte Registrierungen</h2><ul class="list-unstyled mb-0"><% recentUsers.forEach(user => { %><li class="admin-list-row"><a href="/admin/users/<%= user.id %>"><%= user.username %></a><span class="text-secondary"><%= user.created_at %></span></li><% }) %></ul></div></div></section><section class="col-lg-6"><div class="card border-0 h-100"><div class="card-body"><h2 class="h5">Letzte administrative Aktionen</h2><ul class="list-unstyled mb-0"><% logs.forEach(log => { %><li class="admin-list-row"><span><%= log.action %> · <%= log.admin || 'System' %></span><span class="text-secondary"><%= log.created_at %></span></li><% }) %></ul></div></div></section></div>
<p class="text-secondary mt-4">Datenbank: erreichbar · Letztes Backup: Nicht verfügbar</p>
<%- include('partials/end') %>
