<%- include('partials/start') %>
<h1 class="h2 mb-4">System</h1><div class="admin-metrics"><% [['Node.js',version],['App-Version',appVersion],['Uptime',Math.floor(uptime / 60) + ' Min.'],['Prozessspeicher',(memory / 1048576).toFixed(1) + ' MB'],['Datenbankgröße',(size / 1048576).toFixed(2) + ' MB'],['SQLite-Prüfung',check],['Letztes Backup','Nicht verfügbar'],['Aktive Sitzungen',sessions],['Fehler · 24 Stunden','Nicht verfügbar']].forEach(([label,value]) => { %><div class="card border-0"><div class="card-body"><div class="small text-secondary"><%= label %></div><strong><%= value %></strong></div></div><% }) %></div><p class="text-secondary mt-4">Die SQLite-Schnellprüfung wird beim Aufruf ausgeführt. Ein Backup-System ist nicht eingerichtet.</p>
<%- include('partials/end') %>
