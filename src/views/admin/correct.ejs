<%- include('partials/start') %>
<a class="back-link" href="/admin/users/<%= user.id %>/profiles/<%= profile.id %>">← <%= profile.username %></a><h1 class="h2 mt-3">Score korrigieren</h1>
<p>Account: <strong><%= profile.username %></strong> · Eintrag #<%= entry.id %></p><p>Aktuell: <strong><%= entry.score.toLocaleString('de-DE') %></strong> · <%= entry.created_at %></p>
<form class="card border-0" method="post"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="form-label d-block">Neuer Score<input class="form-control" type="text" inputmode="numeric" pattern="[0-9]+" name="score" required <%= preview ? 'readonly' : '' %> value="<%= preview ? preview.newScore : entry.score %>"></label>
<label class="form-label d-block">Neuer Zeitpunkt (UTC)<input class="form-control" type="datetime-local" step="0.001" name="timestamp" required <%= preview ? 'readonly' : '' %> value="<%= (preview ? preview.newTime : entry.created_at).replace('Z','') %>"></label>
<label class="form-label d-block">Begründung<input class="form-control" name="reason" maxlength="500" value="<%= preview ? preview.reason : '' %>" required <%= preview ? 'readonly' : '' %>></label>
<% if (preview) { %><div class="alert <%= preview.warning ? 'alert-warning' : 'alert-info' %>">Vorher: <%= entry.score %> bei <%= entry.created_at %><br>Neu: <%= preview.newScore %> bei <%= preview.newTime %><br>Benachbarte Scores: <%= preview.previous ? preview.previous.score : '–' %> / <%= preview.next ? preview.next.score : '–' %>.<% if (preview.warning) { %> Achtung: Die chronologische Score-Reihenfolge sinkt; Statistiken ändern sich.<% } else { %> Veränderungen und Statistiken werden neu berechnet.<% } %></div>
<input type="hidden" name="oldScore" value="<%= entry.score %>"><input type="hidden" name="oldTime" value="<%= entry.created_at %>"><label class="form-label d-block">Administrator-Passwort<input class="form-control" type="password" name="password" autocomplete="current-password" required></label><label><input type="checkbox" name="confirm" value="yes" required> Korrektur bestätigen</label><div><button class="btn btn-primary mt-3" name="step" value="commit">Korrektur speichern</button></div>
<% } else { %><button class="btn btn-primary mt-3" name="step" value="preview">Änderung prüfen</button><% } %></div></form>
<%- include('partials/end') %>
