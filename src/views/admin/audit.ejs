<%- include('partials/start') %>
<h1 class="h2 mb-4">Audit-Log</h1><form class="admin-filters mb-4" method="get"><input class="form-control" name="action" placeholder="Aktion" value="<%= typeof filters.action === 'string' ? filters.action : '' %>"><input class="form-control" name="admin" type="number" min="1" placeholder="Admin-ID" value="<%= typeof filters.admin === 'string' ? filters.admin : '' %>"><input class="form-control" name="user" type="number" min="1" placeholder="Nutzer-ID" value="<%= typeof filters.user === 'string' ? filters.user : '' %>"><label>Von<input class="form-control" type="date" name="from" value="<%= typeof filters.from === 'string' ? filters.from : '' %>"></label><label>Bis<input class="form-control" type="date" name="to" value="<%= typeof filters.to === 'string' ? filters.to : '' %>"></label><button class="btn btn-primary">Filtern</button></form>
<p class="text-secondary">Die letzten 200 passenden Einträge · Zeitangaben in UTC</p><div class="card border-0"><div class="table-responsive"><table class="table table-dark mb-0"><thead><tr><th>ID</th><th>Zeit</th><th>Administrator</th><th>Aktion</th><th>Nutzer-ID</th><th>Account-ID</th><th>Details</th></tr></thead><tbody><% logs.forEach(log => { %><tr><td><%= log.id %></td><td><%= log.created_at %></td><td><%= log.admin || 'System' %></td><td><%= log.action %></td><td><%= log.user_id || '–' %></td><td><%= log.profile_id || '–' %></td><td><%= log.details || '–' %></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/end') %>
