<%- include('partials/start') %>
<a class="back-link" href="/admin/users/<%= user.id %>">← <%= user.username %></a><h1 class="h2 mt-3"><%= profile.username %> <span class="text-secondary fs-6">#<%= profile.id %></span></h1>
<p class="text-secondary">Schreibgeschützte Ansicht · <%= total %> Einträge · Aktuelle Streak: <%= stats.tracking.current %> · Längste Streak: <%= stats.tracking.longestStreak %></p>
<div class="periods" aria-label="Zeitraum"><% [['1','Tag'],['7','Woche'],['30','Monat'],['183','6 Monate'],['365','Jahr'],['all','Insgesamt']].forEach(([value,label]) => { %><button type="button" class="period-chip <%= value === '7' ? 'is-active' : '' %>" data-days="<%= value %>" aria-pressed="<%= value === '7' %>"><%= label %></button><% }) %></div>
<div id="score-chart-data" data-endpoint="/admin/users/<%= user.id %>/profiles/<%= profile.id %>/chart-data"></div><p id="chart-message" class="text-secondary mt-3" aria-live="polite"></p><div class="chart-wrap"><canvas id="score-chart" role="img" aria-label="Score-Verlauf"></canvas></div>
<h2 class="h4 mt-5">Score-Verlauf</h2><div class="card border-0"><div class="table-responsive"><table class="table table-dark mb-0"><thead><tr><th>ID</th><th>Zeitpunkt (UTC)</th><th>Score</th><th>Veränderung</th><th>Abstand</th><th>Aktion</th></tr></thead><tbody><% history.slice(0, 50).forEach((entry,i) => { const previous = history[i+1]; %><tr><td><%= entry.id %></td><td><%= entry.created_at %></td><td><%= entry.score.toLocaleString('de-DE') %></td><td><%= previous ? (entry.score-previous.score).toLocaleString('de-DE') : '–' %></td><td><%= previous ? Math.round((Date.parse(entry.created_at)-Date.parse(previous.created_at))/60000).toLocaleString('de-DE') + ' Min.' : '–' %></td><td><a href="/admin/users/<%= user.id %>/profiles/<%= profile.id %>/scores/<%= entry.id %>/correct">Korrigieren</a> · <a href="/admin/users/<%= user.id %>/profiles/<%= profile.id %>/scores/<%= entry.id %>/delete">Löschen</a></td></tr><% }) %></tbody></table></div></div>
<% if (page > 1 || history.length > 50) { %><nav class="d-flex gap-3 mt-3" aria-label="Einträge durchblättern"><% if (page > 1) { %><a class="btn btn-secondary" href="?page=<%= page - 1 %>">Neuere Einträge</a><% } %><% if (history.length > 50) { %><a class="btn btn-secondary" href="?page=<%= page + 1 %>">Ältere Einträge</a><% } %></nav><% } %>
<section id="streak" class="mt-5"><h2 class="h4">Streak-Tage</h2><p class="text-secondary">Die letzten 35 Kalendertage in Berlin. Ein entschuldigter Tag zählt für die Streak und erzeugt keinen Score-Eintrag.</p><div class="streak-days mb-4"><% calendar.forEach(day => { %><div><span><%= day.date.slice(5) %></span><span class="streak-day <%= day.type !== 'missing' ? 'is-marked' : '' %>" title="<%= day.type === 'exception' ? 'Ausnahme' : day.type === 'score' ? 'Messung' : 'Kein Eintrag' %>"><%= day.type === 'exception' ? 'A' : day.type === 'score' ? '✓' : '–' %></span></div><% }) %></div><p class="text-secondary">✓ = Messung · A = Ausnahme · – = kein Eintrag</p>
<form class="card border-0" method="post" action="/admin/users/<%= user.id %>/profiles/<%= profile.id %>/streak"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label d-block">Aktion<select class="form-select" name="action"><option value="add">Tag entschuldigen</option><option value="remove">Ausnahme entfernen</option></select></label><label class="form-label d-block">Kalendertag (Berlin)<input class="form-control" type="date" name="day" required></label><label class="form-label d-block">Begründung<input class="form-control" name="reason" maxlength="500" required></label><label><input type="checkbox" name="confirm" value="yes" required> Aktion bestätigen</label><div><button class="btn btn-primary mt-3">Ausführen</button></div></div></form>
<h3 class="h5 mt-4">Vorhandene Ausnahmen</h3><% if (!exceptions.length) { %><p class="text-secondary">Keine Ausnahmen vorhanden.</p><% } %><% exceptions.forEach(item => { %><p><%= item.day %> · <%= item.reason %></p><% }) %></section>
<script src="<%= assetBase %>/vendor/chartjs/chart.umd.js" defer></script><script src="<%= assetBase %>/vendor/chartjs-date/chartjs-adapter-date-fns.bundle.min.js" defer></script><script src="<%= assetBase %>/js/score-chart.js" defer></script>
<%- include('partials/end') %>
