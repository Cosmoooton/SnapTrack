<%- include('partials/start') %>
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><h1 class="h2 mb-0">Nutzer</h1><div class="d-flex flex-wrap gap-2"><a class="btn btn-secondary" href="/admin/users/deleted"><i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>Gelöschte Nutzer</a><a class="btn btn-primary" href="/admin/users/new"><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Nutzer hinzufügen</a></div></div>
<form class="admin-filters mb-4" method="get"><label><span class="visually-hidden">Name oder ID</span><input class="form-control" name="search" value="<%= filters.search %>" placeholder="Name oder ID"></label><label><span class="visually-hidden">Rolle</span><select class="form-select" name="role"><option value="">Alle Rollen</option><% ['user','admin'].forEach(v => { %><option value="<%= v %>" <%= filters.role === v ? 'selected' : '' %>><%= v %></option><% }) %></select></label><label><span class="visually-hidden">Status</span><select class="form-select" name="status"><option value="">Alle Status</option><% ['active','suspended','disabled'].forEach(v => { %><option value="<%= v %>" <%= filters.status === v ? 'selected' : '' %>><%= v %></option><% }) %></select></label><label><span class="visually-hidden">Sortierung</span><select class="form-select" name="sort"><option value="created">Registrierung</option><option value="username" <%= filters.sort === 'username' ? 'selected' : '' %>>Benutzername</option><option value="login" <%= filters.sort === 'login' ? 'selected' : '' %>>Letzte Anmeldung</option></select></label><button class="btn btn-primary">Anwenden</button></form>
<p class="text-secondary"><%= total %> Nutzer · Seite <%= filters.page %></p>
<div class="card border-0"><div class="table-responsive"><table class="table table-dark table-hover align-middle mb-0"><thead><tr><th>ID</th><th>Benutzername</th><th>Rolle</th><th>Status</th><th>Registriert</th><th>Letzter Login</th><th>Accounts</th><th>Scores</th></tr></thead><tbody><% rows.forEach(user => { %><tr><td><%= user.id %></td><td><a href="/admin/users/<%= user.id %>"><%= user.username %></a></td><td><%= user.role %></td><td><%= user.status %></td><td><%= user.created_at %></td><td><%= user.last_login_at || 'Nicht verfügbar' %></td><td><%= user.profiles %></td><td><%= user.scores %></td></tr><% }) %></tbody></table></div></div>
<div class="d-flex gap-3 mt-4"><% if (filters.page > 1) { %><a href="?search=<%= encodeURIComponent(filters.search) %>&role=<%= encodeURIComponent(filters.role || '') %>&status=<%= encodeURIComponent(filters.status || '') %>&sort=<%= encodeURIComponent(filters.sort || '') %>&page=<%= filters.page-1 %>">Zurück</a><% } %><% if (filters.page * 25 < total) { %><a href="?search=<%= encodeURIComponent(filters.search) %>&role=<%= encodeURIComponent(filters.role || '') %>&status=<%= encodeURIComponent(filters.status || '') %>&sort=<%= encodeURIComponent(filters.sort || '') %>&page=<%= filters.page+1 %>">Weiter</a><% } %></div>
<%- include('partials/end') %>
