<%- include('partials/start') %>
<a href="/admin/users" class="back-link">← Nutzer</a><% if (created) { %><div class="alert alert-success mt-3" role="status">Nutzer wurde angelegt.</div><% } %><h1 class="h2 mt-3"><%= user.username %> <span class="text-secondary fs-6">#<%= user.id %></span></h1>
<div class="admin-metrics mt-4"><% [['Rolle',user.role],['Status',user.status],['Registriert',user.created_at],['Letzter Login',user.last_login_at || 'Nicht verfügbar'],['Accounts',user.profiles],['Score-Einträge',user.scores],['Letzte Aktivität','Nicht verfügbar'],['Sitzungen',sessions]].forEach(([label,value]) => { %><div class="card border-0"><div class="card-body"><div class="small text-secondary"><%= label %></div><strong><%= value %></strong></div></div><% }) %></div>
<a class="btn btn-secondary mt-4" href="/admin/users/<%= user.id %>/diagnose"><i class="bi bi-clipboard-check me-2" aria-hidden="true"></i>Daten prüfen</a>
<a class="btn btn-secondary mt-4" href="/admin/users/<%= user.id %>/deleted"><i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>Gelöschte Daten</a>
<a class="btn btn-outline-danger mt-4" href="/admin/users/<%= user.id %>/delete"><i class="bi bi-person-x me-2" aria-hidden="true"></i>Nutzer löschen</a>
<section class="mt-5"><h2 class="h4">Rolle und Kontostatus ändern</h2><p class="text-secondary">Eine Sperre beendet den Zugriff auch für bestehende Sitzungen.</p><form method="post" action="/admin/users/<%= user.id %>/access" class="card border-0"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="role">Rolle</label><select class="form-select" id="role" name="role"><% ['user','admin'].forEach(v => { %><option <%= user.role === v ? 'selected' : '' %> value="<%= v %>"><%= v %></option><% }) %></select></div><div class="col-md-6"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><% ['active','suspended','disabled'].forEach(v => { %><option <%= user.status === v ? 'selected' : '' %> value="<%= v %>"><%= v %></option><% }) %></select></div><div class="col-12"><label class="form-label" for="reason">Begründung</label><input class="form-control" id="reason" name="reason" maxlength="500" required></div><div class="col-12"><label class="form-label" for="password">Dein Administrator-Passwort</label><input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required></div><div class="col-12"><label><input type="checkbox" name="confirm" value="yes" required> Änderung bestätigen</label></div></div><button class="btn btn-primary mt-3">Änderung speichern</button></div></form></section>
<section class="mt-5"><h2 class="h4">Snapchat-Accounts</h2><div class="card border-0"><div class="table-responsive"><table class="table table-dark mb-0"><thead><tr><th>Account</th><th>ID</th><th>Erstellt</th><th>Aktueller Score</th><th>Letzte Erfassung</th><th>Einträge</th><th>Streak aktuell / längste</th></tr></thead><tbody><% profiles.forEach(profile => { %><tr><td><a href="/admin/users/<%= user.id %>/profiles/<%= profile.id %>"><%= profile.username %></a></td><td><%= profile.id %></td><td><%= profile.created_at %></td><td><%= profile.latest_score === null ? '–' : profile.latest_score.toLocaleString('de-DE') %></td><td><%= profile.latest_at || '–' %></td><td><%= profile.score_count %></td><td><%= profile.currentStreak %> / <%= profile.longestStreak %></td></tr><% }) %></tbody></table></div></div><% if (!profiles.length) { %><p class="text-secondary mt-3">Keine Accounts vorhanden.</p><% } %></section>
<section id="support" class="mt-5"><h2 class="h4">Interne Support-Notizen</h2><p class="text-secondary">Nur für Administratoren sichtbar.</p><form method="post" action="/admin/users/<%= user.id %>/notes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="content">Neue Notiz</label><textarea class="form-control" id="content" name="content" maxlength="2000" required rows="3"></textarea><button class="btn btn-primary mt-3">Notiz speichern</button></form><% notes.forEach(note => { %><div class="card border-0 mt-3"><div class="card-body"><p class="admin-note"><%= note.content %></p><small class="text-secondary"><%= note.admin %> · <%= note.created_at %> UTC</small></div></div><% }) %></section>
<section class="mt-5"><h2 class="h4">Alle Sitzungen beenden</h2><p class="text-secondary">Der Nutzer muss sich auf allen Geräten erneut anmelden.</p><form class="card border-0" method="post" action="/admin/users/<%= user.id %>/sessions/revoke"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="revoke-reason">Begründung</label><input class="form-control mb-3" id="revoke-reason" name="reason" maxlength="500" required><label class="form-label" for="revoke-password">Dein Administrator-Passwort</label><input type="password" class="form-control mb-3" id="revoke-password" name="password" autocomplete="current-password" required><label><input type="checkbox" name="confirm" value="yes" required> Sitzungen beenden bestätigen</label><div><button class="btn btn-danger mt-3">Alle Sitzungen beenden</button></div></div></form></section>
<section class="mt-5"><h2 class="h4">Einzelne Sitzungen</h2><p class="text-secondary">IP-Adresse und Gerät werden bei der Anmeldung erfasst. Der Standort ist nicht verfügbar.</p><% if (!sessionList.length) { %><p class="text-secondary">Keine aktiven Sitzungen.</p><% } %><% sessionList.forEach((session, index) => { %><details class="card border-0 mb-2"><summary class="card-body"><%= session.device || 'Unbekanntes Gerät' %><%= session.current ? ' · Diese Sitzung' : '' %> · Sitzung <%= index + 1 %></summary><div class="card-body pt-0"><dl><dt>IP-Adresse beim Login</dt><dd><%= session.ip || 'Nicht verfügbar' %></dd><dt>Gerät und Browser</dt><dd><%= session.device || 'Nicht verfügbar' %></dd><dt>Standort</dt><dd>Nicht verfügbar</dd><dt>Gültig bis</dt><dd><%= new Date(session.expires).toLocaleString('de-DE', {timeZone:'Europe/Berlin'}) %></dd></dl><form method="post" action="/admin/users/<%= user.id %>/sessions/single"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="handle" value="<%= session.handle %>"><label class="form-label d-block">Begründung<input class="form-control" name="reason" maxlength="500" required></label><label class="form-label d-block">Administrator-Passwort<input class="form-control" name="password" type="password" autocomplete="current-password" required></label><label><input type="checkbox" name="confirm" value="yes" required> Sitzung beenden bestätigen</label><div><button class="btn btn-danger mt-3">Sitzung beenden</button></div></form></div></details><% }) %></section>
<section class="mt-5"><h2 class="h4">Passwort-Support</h2><p class="text-secondary">Der Reset-Link ist einmalig und 30 Minuten gültig. Eine erzwungene Änderung beendet bestehende Sitzungen.</p><form class="card border-0" method="post" action="/admin/users/<%= user.id %>/password/reset"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label d-block">Begründung<input class="form-control" name="reason" maxlength="500" required></label><label class="form-label d-block">Dein Administrator-Passwort<input type="password" class="form-control" name="password" autocomplete="current-password" required></label><label><input type="checkbox" name="confirm" value="yes" required> Aktion bestätigen</label><div class="form-actions mt-3"><button class="btn btn-primary" type="submit">Reset-Link erstellen</button><button class="btn btn-secondary" type="submit" formaction="/admin/users/<%= user.id %>/password/require">Passwortänderung erzwingen</button></div></div></form></section>
<%- include('partials/end') %>
