<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container dashboard py-4 py-md-5">
  <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3 mb-4">
    <div class="page-heading mb-0"><p class="page-kicker">DEINE ACCOUNTS</p><h1>Accounts verwalten</h1><p>Füge Snapchat-Accounts hinzu oder bearbeite sie.</p></div>
    <a class="btn btn-primary action-button" href="/profiles/new"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Account hinzufügen</a>
  </div>
  <% if (!profiles.length) { %>
    <section class="card border-0 shadow-sm surface-card text-center"><div class="card-body empty-state"><span class="empty-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></span><h2 class="h5 fw-semibold mt-4">Noch keine Accounts</h2><p class="text-secondary mb-4">Füge deinen ersten Snapchat-Account hinzu.</p><a class="btn btn-primary" href="/profiles/new"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Account hinzufügen</a></div></section>
  <% } else { %>
    <section class="card border-0 shadow-sm surface-card" aria-labelledby="profiles-heading">
      <div class="px-4 pt-4 pb-2 d-flex align-items-center justify-content-between"><h2 id="profiles-heading" class="h6 fw-semibold mb-0">Accounts</h2><span class="profile-count"><%= profiles.length %></span></div>
      <ul class="list-unstyled mb-0 px-4"><% profiles.forEach(profile => { %>
        <li class="profile-row"><div class="profile-identity"><span class="profile-avatar"><i class="bi bi-person" aria-hidden="true"></i></span><div class="min-width-0"><div class="fw-semibold profile-name"><%= profile.username %></div><div class="small text-secondary">Snapchat-Account</div></div></div>
          <div class="profile-actions"><a class="btn btn-secondary icon-action" href="/profiles/<%= profile.id %>/edit" aria-label="<%= profile.username %> bearbeiten" title="Bearbeiten"><i class="bi bi-pencil" aria-hidden="true"></i></a><a class="btn btn-secondary icon-action text-danger" href="/profiles/<%= profile.id %>/delete" aria-label="<%= profile.username %> löschen" title="Löschen"><i class="bi bi-trash3" aria-hidden="true"></i></a></div></li>
      <% }) %></ul>
    </section>
  <% } %>
</main>
<%- include('../partials/footer') %>
