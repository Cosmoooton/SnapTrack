<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container dashboard py-4 py-md-5">
  <a href="/profiles/<%= profileId %>?tab=liste" class="back-link"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Zurück zum Profil</a>
  <div class="card border-0 shadow-sm surface-card form-card mt-4"><div class="card-body p-4 p-sm-5">
    <h1 class="h3 fw-semibold">Eintrag löschen?</h1>
    <p class="text-secondary">Möchtest du den Eintrag mit <strong class="text-body"><%= entry.score.toLocaleString('de-DE') %></strong> Punkten wirklich löschen?</p>
    <form method="post" action="/profiles/<%= profileId %>/scores/<%= entry.id %>/delete" class="form-actions mt-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger" type="submit">Eintrag löschen</button><a class="btn btn-secondary" href="/profiles/<%= profileId %>?tab=liste">Abbrechen</a>
    </form>
  </div></div>
</main>
<%- include('../partials/footer') %>
